rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registros/{doc} {
      allow read, write: if true;
    }
    match /config/{doc} {
      allow read, write: if true;
    }
    match /leno_srl/{doc} {
      allow read, write: if true;
    }
    match /compras_carne/{doc} {
      allow read, write: if true;
    }
    match /merma_pollo/{doc} {
      allow read, write: if true;
    }
    match /compras_stock_inicial/{doc} {
      allow read, write: if true;
    }
  }
}
